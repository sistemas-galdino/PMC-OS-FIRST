# Template de variáveis de ambiente do frontend (Vite). NÃO coloque segredos aqui.
# Copie para os arquivos reais (gitignored):
#   .env.local              -> PRODUÇÃO  (usado por `npm run dev:prod`, `build` e pelos scripts em /scripts)
#   .env.development.local  -> DEV       (usado por `npm run dev` — sobrepõe o .env.local em modo development)

# URL do projeto Supabase deste ambiente
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co

# Chave publishable (anon) do mesmo projeto
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx

# Rótulo do ambiente: "dev" mostra o banner de ambiente; ausente ou "producao" = produção (sem banner)
VITE_APP_ENV=dev

# Service role key — usada APENAS pelos scripts Node em /scripts (não tem prefixo VITE_, então
# nunca é exposta ao bundle do browser). Mantenha só no .env.local. Nunca commite.
SECRET_KEY=sb_secret_xxx
